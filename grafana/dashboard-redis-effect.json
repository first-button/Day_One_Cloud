{
  "dashboard": {
    "title": "Redis Effect - API Availability",
    "tags": ["redis", "load-test", "k6"],
    "timezone": "Asia/Seoul",
    "refresh": "5s",
    "time": { "from": "now-30m", "to": "now" },
    "panels": [
      {
        "type": "row",
        "title": "API Availability (Redis Effect)",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
        "collapsed": false
      },
      {
        "type": "gauge",
        "title": "API Availability",
        "description": "Non-upload endpoints responding rate",
        "gridPos": { "h": 8, "w": 6, "x": 0, "y": 1 },
        "datasource": { "uid": "efe2u7f2s58u8b" },
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "min": 0, "max": 1,
            "thresholds": { "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.9 },
              { "color": "green", "value": 0.95 }
            ]}
          }
        },
        "targets": [
          {
            "expr": "sum(rate(http_requests_total{job=\"dev-backend\", handler=\"/api/auth/login\", status=~\"2..\"}[1m])) / sum(rate(http_requests_total{job=\"dev-backend\", handler=\"/api/auth/login\"}[1m]))",
            "legendFormat": "Login API",
            "refId": "A"
          }
        ]
      },
      {
        "type": "timeseries",
        "title": "API Response Time (Login vs Upload)",
        "description": "Upload should not block other endpoints",
        "gridPos": { "h": 8, "w": 9, "x": 6, "y": 1 },
        "datasource": { "uid": "efe2u7f2s58u8b" },
        "fieldConfig": {
          "defaults": { "unit": "s", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 } }
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"dev-backend\", handler=\"/api/auth/login\"}[1m])))",
            "legendFormat": "Login p95",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"dev-backend\", handler=\"/api/schedule/upload\"}[1m])))",
            "legendFormat": "Upload p95",
            "refId": "B"
          }
        ]
      },
      {
        "type": "timeseries",
        "title": "Request Rate by Endpoint",
        "gridPos": { "h": 8, "w": 9, "x": 15, "y": 1 },
        "datasource": { "uid": "efe2u7f2s58u8b" },
        "fieldConfig": {
          "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 } }
        },
        "targets": [
          {
            "expr": "sum(rate(http_requests_total{job=\"dev-backend\", handler=\"/api/auth/login\"}[1m]))",
            "legendFormat": "Login RPS",
            "refId": "A"
          },
          {
            "expr": "sum(rate(http_requests_total{job=\"dev-backend\", handler=\"/api/schedule/upload\"}[1m]))",
            "legendFormat": "Upload RPS",
            "refId": "B"
          }
        ]
      },
      {
        "type": "row",
        "title": "Upload Pipeline",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
        "collapsed": false
      },
      {
        "type": "gauge",
        "title": "Concurrent Uploads",
        "gridPos": { "h": 8, "w": 6, "x": 0, "y": 10 },
        "datasource": { "uid": "efe2u7f2s58u8b" },
        "fieldConfig": {
          "defaults": {
            "min": 0, "max": 20,
            "thresholds": { "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 10 }
            ]}
          }
        },
        "targets": [
          {
            "expr": "concurrent_uploads{job=\"dev-backend\"}",
            "legendFormat": "Concurrent",
            "refId": "A"
          }
        ]
      },
      {
        "type": "timeseries",
        "title": "Upload API Response Time (p50 / p95)",
        "description": "With Redis: should be <1s (just queuing). Without: 5-15s (full processing)",
        "gridPos": { "h": 8, "w": 9, "x": 6, "y": 10 },
        "datasource": { "uid": "efe2u7f2s58u8b" },
        "fieldConfig": {
          "defaults": { "unit": "s", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 } }
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"dev-backend\", handler=\"/api/schedule/upload\"}[1m])))",
            "legendFormat": "Upload p50",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"dev-backend\", handler=\"/api/schedule/upload\"}[1m])))",
            "legendFormat": "Upload p95",
            "refId": "B"
          }
        ]
      },
      {
        "type": "timeseries",
        "title": "Error Rate",
        "gridPos": { "h": 8, "w": 9, "x": 15, "y": 10 },
        "datasource": { "uid": "efe2u7f2s58u8b" },
        "fieldConfig": {
          "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 } }
        },
        "targets": [
          {
            "expr": "sum(rate(http_requests_total{job=\"dev-backend\", status=~\"5..\"}[1m]))",
            "legendFormat": "5xx errors",
            "refId": "A"
          },
          {
            "expr": "sum by (error_type) (rate(upload_errors_total{job=\"dev-backend\"}[1m]))",
            "legendFormat": "{{error_type}}",
            "refId": "B"
          }
        ]
      }
    ],
    "schemaVersion": 39
  },
  "overwrite": true
}
